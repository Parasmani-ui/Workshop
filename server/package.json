{
  "name": "chanakya-sim-server",
  "version": "1.0.0",
  "description": "Chanakya BizSimulation — Node.js + Express + TypeScript server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node src/scripts/seedAll.ts",
    "seed:all": "ts-node src/scripts/seedAll.ts",
    "seed:mpx": "ts-node src/scripts/seedMPX.ts",
    "db:clear": "ts-node src/scripts/clearDB.ts",
    "test:routes": "ts-node src/scripts/testRoutes.ts",
    "test:engine": "ts-node src/scripts/testEngineRun.ts",
    "validate:golden": "ts-node src/scripts/goldenValidation.ts",
    "seed:paper": "ts-node src/scripts/seedPaper.ts",
    "validate:paper": "ts-node src/scripts/validatePaper.ts",
    "seed:beer": "ts-node src/scripts/seedBeer.ts",
    "validate:beer": "ts-node src/scripts/validateBeer.ts",
    "validate:all": "ts-node src/scripts/validateAll.ts"
  },
  "dependencies": {
    "express": "^4.18.0",
    "mongoose": "^8.0.0",
    "socket.io": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "zod": "^3.23.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/cors": "^2.8.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/jsonwebtoken": "^9.0.0",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0"
  }
}
